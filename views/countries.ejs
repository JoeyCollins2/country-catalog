<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Countries</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet">
  <style>
    #map { height: 400px; display: none; }
  </style>
</head>
<body class="container py-4">
  <h1>Countries</h1>

  <table class="table">
    <tr>
      <th>Name</th>
      <th>Popular Site</th>
      <th>Capital</th>
      <th>Population</th>
      <th>Visited</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>

    <% countries.forEach(country => { %>
      <tr>
        <td><%= country.country_name %></td>
        <td><%= country.popular_site %></td>
        <td><%= country.capital %></td>
        <td><%= country.population %></td>
        <td><%= country.visited %></td>
        <td>
          <a href="/editCountry/<%= country.country_id %>" class="btn btn-warning btn-sm">Edit</a>
        </td>
        <td>
          <form action="/deleteCountry/<%= country.country_id %>" method="POST"
                onsubmit="return confirm('Delete <%= country.country_name %>?')">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
          </form>
        </td>
        <td>
          <button type="button" class="btn btn-info btn-sm" onclick="showMap(<%= country.country_id %>)">Map</button>
        </td>
      </tr>
    <% }); %>
  </table>

  <a href="/addCountry" class="btn btn-primary">Add Country</a>
  <a href="/logout" class="btn btn-secondary">Logout</a>

  <p id="status" class="mt-3"></p>
  <h2 id="mapTitle" class="h4"></h2>
  <div id="map" class="mt-3"></div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    let map;
    let marker;

    function showMap(countryId) {
      const status = document.getElementById("status");
      const mapTitle = document.getElementById("mapTitle");
      const mapDiv = document.getElementById("map");

      status.textContent = "Loading...";

      fetch("/api/country/" + countryId)
        .then(response => response.json())
        .then(data => {
          if (data.error) {
            status.textContent = data.error;
            return;
          }

          status.textContent = "";
          mapTitle.textContent = data.name;
          mapDiv.style.display = "block";

          if (!map) {
            map = L.map("map");
            L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
              maxZoom: 19,
              attribution: "&copy; OpenStreetMap contributors"
            }).addTo(map);
          }

          const [south, north, west, east] = data.bounds;
          map.fitBounds([[south, west], [north, east]]);

          if (marker) {
            map.removeLayer(marker);
          }
          marker = L.marker([data.lat, data.lon]).addTo(map).bindPopup(data.name).openPopup();

          mapDiv.scrollIntoView({ behavior: "smooth" });
        })
        .catch(() => {
          status.textContent = "Error retrieving map";
        });
    }
  </script>
</body>
</html>