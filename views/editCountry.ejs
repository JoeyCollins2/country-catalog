<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit Country</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container py-4">
  <h1>Edit Country</h1>

  <% if (errors.length > 0) { %>
    <div class="alert alert-danger">
      <% errors.forEach(e => { %>
        <div><%= e %></div>
      <% }); %>
    </div>
  <% } %>

  <form action="/editCountry/<%= country.country_id %>" method="POST">
    <div class="mb-3">
      <label for="country_name" class="form-label">Country Name</label>
      <input type="text" id="country_name" name="country_name" class="form-control" maxlength="30" required
             value="<%= country.country_name %>">
    </div>
    <div class="mb-3">
      <label for="popular_site" class="form-label">Popular Site</label>
      <input type="text" id="popular_site" name="popular_site" class="form-control" maxlength="50" required
             value="<%= country.popular_site %>">
    </div>
    <div class="mb-3">
      <label for="capital" class="form-label">Capital</label>
      <input type="text" id="capital" name="capital" class="form-control" maxlength="30" required
             value="<%= country.capital %>">
    </div>
    <div class="mb-3">
      <label for="population" class="form-label">Population</label>
      <input type="number" id="population" name="population" class="form-control" min="0" step="1" required
             value="<%= country.population %>">
    </div>
    <div class="mb-3">
      <label for="visited" class="form-label">Visited</label>
      <select id="visited" name="visited" class="form-select">
        <option value="">--</option>
        <option value="Y" <%= country.visited === "Y" ? "selected" : "" %>>Y</option>
        <option value="N" <%= country.visited === "N" ? "selected" : "" %>>N</option>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/countries" class="btn btn-secondary">Cancel</a>
  </form>
</body>
</html>